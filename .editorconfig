root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

[*.cs]
# Playwright E2E rules (E2ETestRules analyzer)
dotnet_diagnostic.PWNET001.severity = error
dotnet_diagnostic.PWNET002.severity = warning
dotnet_diagnostic.PWNET003.severity = warning
dotnet_diagnostic.PWNET004.severity = warning
dotnet_diagnostic.PWNET005.severity = error
dotnet_diagnostic.PWNET006.severity = warning
# async void tests are never run correctly by the runner: deterministic, so error.
dotnet_diagnostic.PWNET007.severity = error
dotnet_diagnostic.PWNET008.severity = warning
dotnet_diagnostic.PWNET009.severity = warning
dotnet_diagnostic.PWNET010.severity = warning
